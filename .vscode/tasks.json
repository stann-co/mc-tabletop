{
  // Ctrl+Shift+P > "Tasks: Run Task" lists these.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tabletop: play (server + 2 players)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\play.ps1",
      "problemMatcher": []
    },
    {
      "label": "Tabletop: play (server + 1 player)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\play.ps1 -Players 1",
      "problemMatcher": []
    },
    {
      "label": "Tabletop: update modpack",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\sync-pack.ps1",
      "problemMatcher": []
    },
    {
      "label": "Tabletop: build jar",
      "type": "shell",
      "command": ".\\gradlew.bat build",
      "problemMatcher": []
    }
  ]
}
